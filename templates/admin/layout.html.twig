{% extends baseLayout %}
{% block title %}Harvest · Folio sets{% endblock %}
{% block navbar_title %}Harvest{% endblock %}
{% block body %}
<style>
.harvest-admin{--h-ink:#172d36;--h-muted:#61747b;--h-line:#dbe5e6;--h-accent:#126c60;color:var(--h-ink);font:15px/1.55 system-ui,sans-serif;max-width:1180px;margin:0 auto;padding:28px 24px 64px}.harvest-admin *{box-sizing:border-box}.harvest-admin a{color:var(--h-accent);text-decoration:none}.harvest-admin a:hover{text-decoration:underline}.harvest-admin h1{font-size:32px;letter-spacing:-1px;margin:0 0 6px}.harvest-admin h2{font-size:19px;margin:0 0 12px}.harvest-admin h3{font-size:16px;margin:0 0 8px}.harvest-admin p{margin:0 0 14px}.harvest-admin .h-muted{color:var(--h-muted)}.harvest-admin .h-eyebrow{text-transform:uppercase;letter-spacing:1.8px;font-size:11px;font-weight:750;margin-bottom:8px}.harvest-admin .h-header,.harvest-admin .h-toolbar{display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap}.harvest-admin .h-nav{display:flex;gap:6px;border-bottom:1px solid var(--h-line);margin:22px 0}.harvest-admin .h-nav a{padding:10px 16px;border-bottom:3px solid transparent;color:var(--h-muted);font-weight:650}.harvest-admin .h-nav a[aria-current=page]{border-color:var(--h-accent);color:var(--h-accent)}.harvest-admin .h-card{background:#fff;border:1px solid var(--h-line);border-radius:12px;padding:22px;margin-bottom:20px}.harvest-admin .h-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}.harvest-admin .h-stat{font-size:30px;font-weight:720;letter-spacing:-1px;display:block}.harvest-admin .h-pill{display:inline-block;background:#eaf4f0;color:#236553;padding:3px 9px;border-radius:20px;font-size:12px;font-weight:650}.harvest-admin .h-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.harvest-admin button,.harvest-admin .h-button{display:inline-flex;align-items:center;justify-content:center;background:var(--h-accent);color:white;border:1px solid var(--h-accent);border-radius:7px;padding:9px 15px;font:600 14px system-ui;cursor:pointer;text-decoration:none}.harvest-admin .h-secondary{color:var(--h-accent);background:white}.harvest-admin button:disabled{opacity:.45;cursor:not-allowed}.harvest-admin input[type=search],.harvest-admin select{border:1px solid var(--h-line);border-radius:7px;padding:10px 12px;background:#fff;color:var(--h-ink);font:inherit;max-width:100%;min-height:42px}.harvest-admin label{display:block;font-size:13px;font-weight:600}.harvest-admin .h-filters{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-bottom:18px}.harvest-admin .h-filters .h-query{flex:1;min-width:200px}.harvest-admin .h-query input{width:100%}.harvest-admin .h-table-wrap{overflow-x:auto}.harvest-admin table{width:100%;border-collapse:collapse;text-align:left;font-size:14px}.harvest-admin th{font-weight:600;color:var(--h-muted);font-size:12px;text-transform:uppercase;letter-spacing:.5px}.harvest-admin td,.harvest-admin th{padding:13px 10px;border-bottom:1px solid var(--h-line);vertical-align:top}.harvest-admin td:first-child,.harvest-admin th:first-child{padding-left:0}.harvest-admin small{display:block;color:var(--h-muted);overflow-wrap:anywhere}.harvest-admin code{font-size:12px;background:#f2f6f5;padding:2px 4px;border-radius:3px;overflow-wrap:anywhere}.harvest-admin pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f2f6f5;border-radius:7px;padding:16px;font:12px/1.6 ui-monospace,monospace;max-height:480px;overflow:auto}.harvest-admin .h-notice{padding:15px 18px;border-left:3px solid var(--h-accent);background:#edf6f2;margin-bottom:20px;border-radius:0 7px 7px 0}.harvest-admin .h-error{border-color:#a83730;background:#fdf0ed}.harvest-admin .h-empty{text-align:center;padding:32px 12px;color:var(--h-muted)}.harvest-admin .h-pagination{display:flex;justify-content:space-between;align-items:center;margin-top:18px}.harvest-admin details summary{cursor:pointer;font-weight:600}.harvest-admin .h-result{border-top:1px solid var(--h-line);padding:20px 0}.harvest-admin .h-result:first-of-type{border-top:0}.harvest-admin .h-result h2{margin-bottom:4px}.harvest-admin dl{display:grid;grid-template-columns:140px 1fr;gap:10px}.harvest-admin dt{font-weight:600}.harvest-admin dd{margin:0;overflow-wrap:anywhere}@media(max-width:600px){.harvest-admin{padding:18px 14px 48px}.harvest-admin h1{font-size:27px}.harvest-admin .h-card{padding:16px}.harvest-admin .h-nav a{padding:10px;font-size:13px}.harvest-admin .h-grid{grid-template-columns:1fr 1fr}.harvest-admin dl{grid-template-columns:1fr}.harvest-admin dd{margin-bottom:8px}}
</style>
<main class="harvest-admin">
    <header class="h-header"><div><div class="h-eyebrow">Folio collections</div><h1>Harvest</h1><p class="h-muted">Discover folios. Keep your collections in sync.</p></div><span class="h-pill">Application catalog</span></header>
    <nav class="h-nav" aria-label="Harvest administration">
        <a href="{{ path('survos_harvest_admin') }}" {% if app.request.attributes.get('_route') in ['survos_harvest_admin', 'survos_harvest_dataset'] %}aria-current="page"{% endif %}>Local catalog</a>
        <a href="{{ path('survos_harvest_search') }}" {% if app.request.attributes.get('_route') == 'survos_harvest_search' %}aria-current="page"{% endif %}>Search Harvest API</a>
        <a href="{{ path('survos_harvest_help') }}" {% if app.request.attributes.get('_route') == 'survos_harvest_help' %}aria-current="page"{% endif %}>Help &amp; folio sets</a>
    </nav>
    {% block harvest_content %}{% endblock %}
    <p class="h-muted"><small>Harvest source · {{ source }}</small></p>
</main>
{% endblock %}
