{
    "name": "survos/harvest-bundle",
    "description": "Symfony integration for sites consuming folios from the Harvest server",
    "keywords": [
        "symfony",
        "harvest",
        "folio"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "survos/kit-bundle": "^2.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "symfony/framework-bundle": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Survos\\HarvestBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\HarvestBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    }
}
